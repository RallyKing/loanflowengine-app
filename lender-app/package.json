{
  "name": "direct-lending-connection",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "clean": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){process.exit(0)}\"",
    "dev": "concurrently --kill-others-on-fail false --names \"next,convex\" \"next dev -p 3004\" \"convex dev --typecheck disable\"",
    "dev:next": "next dev -p 3004",
    "debug:log-ping": "node scripts/debug-log-ping.mjs",
    "dev:convex": "convex dev --typecheck disable",
    "convex:once": "convex dev --once --typecheck disable",
    "convex:codegen": "convex codegen --typecheck disable",
    "deploy:vercel": "npx vercel@latest deploy --prod --yes --project loanflowengine",
    "deploy:prod": "node scripts/with-git-sha.mjs npm run build && npx vercel@latest deploy --prod --yes --project loanflowengine",
    "deploy:prod:dlc": "npm run deploy:prod",
    "convex:deploy:prod": "convex deploy -y --typecheck disable --env-file .env.convex.prod",
    "build": "node scripts/verify-convex-query-architecture.mjs && node scripts/verify-auth-username-index.mjs && next build",
    "sync:pdf-worker": "node scripts/sync-pdf-worker.mjs",
    "postinstall": "node scripts/sync-pdf-worker.mjs",
    "rebuild": "npm run clean && npm run build",
    "validate:block-registry": "tsx scripts/validate-pipeline-block-registry.ts",
    "verify": "npx tsc --noEmit && npm run validate:block-registry && npx next lint && npm run clean && npx next build",
    "verify:env": "tsx scripts/verify-convex-env.ts",
    "verify:deployment": "node scripts/verify-prod-deployment-alignment.mjs",
    "audit:env-reconciliation": "node scripts/env-reconciliation-audit.mjs",
    "go-live:status": "node scripts/go-live-system-status.mjs",
    "verify:auth-username": "node scripts/verify-auth-username-index.mjs",
    "data:link": "tsx scripts/check-convex-data-link.ts",
    "live:smoke": "tsx scripts/smoke-convex-live.ts",
    "live:check": "npm run verify:env && npm run data:link && npm run live:smoke",
    "live:auth-bridge": "tsx scripts/auth-bridge-probe.ts",
    "auth:validate": "node scripts/prod-native-auth-validation.mjs",
    "admin:referential-integrity": "tsx scripts/run-referential-integrity.ts --prod --repair",
    "verify:auth-crypto": "tsx scripts/full-auth-crypto-verification.ts",
    "verify:auth-crypto:local": "tsx scripts/full-auth-crypto-verification.ts --local-only",
    "admin:reset-password": "tsx scripts/reset-auth-user-password.ts",
    "admin:ensure-primary": "tsx scripts/ensure-primary-platform-admin.ts",
    "admin:diagnose-auth": "tsx scripts/diagnose-auth-user.ts",
    "admin:grant-global-admin": "tsx scripts/grant-global-admin.ts",
    "admin:single-tenant-consolidate": "tsx scripts/run-single-tenant-consolidate.ts",
    "admin:primary-consolidation": "tsx scripts/run-primary-account-full-consolidation.ts",
    "admin:joshua-rebind": "tsx scripts/run-joshua-explicit-rebind.ts",
    "admin:joshua-legacy-cleanup": "tsx scripts/operator-joshua-legacy-key-cleanup.ts",
    "admin:hard-reset-native-auth": "tsx scripts/hard-reset-native-auth-email.ts",
    "test:core": "tsx scripts/core-edge-tests.ts",
    "test:document-creator": "tsx scripts/document-vault-creator-tests.ts",
    "test:regression:unit": "tsx scripts/regression-protection-tests.ts",
    "verify:regression": "npm run audit:no-clerk && tsx scripts/regression-protection-tests.ts",
    "test:regression:e2e": "npm run build && playwright test tests/regression/regression-protection.spec.ts tests/auth/auth-stress.spec.ts tests/regression/multi-session-isolation.spec.ts --project chromium",
    "test:perf": "tsx scripts/perf-scale-check.ts",
    "verify:all": "npm run verify && npm run verify:env && npm run test:core && npm run test:e2e",
    "test:e2e": "npm run build && playwright test",
    "test:mobile": "npm run build && playwright test tests/mobile --project \"Mobile Chrome\" --project \"Mobile Safari\"",
    "test:mobile:matrix": "npm run build && playwright test tests/mobile --project \"Mobile Chrome\" --project \"Mobile Chrome Galaxy\" --project \"Mobile Safari\" --project \"Mobile Safari SE\" --project \"iPad\"",
    "test:mobile:prod": "node scripts/run-mobile-prod-playwright.mjs",
    "test:regression": "npm run build && playwright test tests/regression",
    "test:visual": "npm run build && playwright test tests/visual --project visual-desktop --project visual-mobile-pixel --project visual-mobile-iphone14pro --project visual-mobile-ipad",
    "test:performance": "npm run build && playwright test tests/performance",
    "test:smoke": "npm run build && playwright test tests/e2e/smoke.spec.ts tests/e2e/production-smoke.spec.ts tests/auth",
    "test:auth": "npx playwright test tests/auth",
    "test:integrations": "npm run build && playwright test tests/integrations",
    "seed:test-data": "tsx scripts/seed-testing-data.ts",
    "test:e2e:mobile-pipeline-scroll": "npm run build && playwright test tests/e2e/pipeline-scroll.spec.ts --project \"Mobile Chrome\" --project \"Mobile Safari\"",
    "test:e2e:phase15-15a-viewport": "playwright test tests/e2e/phase15-step15A-mobile-viewport.spec.ts --project chromium",
    "report:phase15-15a-viewport": "node scripts/phase15-step15A-viewport-cert-report.mjs",
    "cert:phase15-15-sharing": "tsx scripts/run-phase15-step15-sharing-certification.ts",
    "cert:phase16-2-event-foundation": "tsx scripts/run-phase16-step2-event-foundation.ts",
    "cert:phase16-3-event-collaboration": "tsx scripts/run-phase16-step3-event-collaboration.ts",
    "cert:phase16-3A-events-qc": "tsx scripts/run-phase16-step3A-events-qc.ts",
    "test:e2e:stress": "npm run build && playwright test tests/e2e/stress.spec.ts",
    "test:e2e:ui": "npm run build && playwright test --ui",
    "start": "next start -p 3004",
    "lint": "next lint",
    "rebuild:search": "npx convex run lenders:rebuildLenderSearchText",
    "enrich:all": "tsx scripts/enrich-all.mts",
    "seed": "tsx scripts/seed.mts",
    "restore:data-backup": "tsx scripts/restore-data-backup.mts",
    "validate:system": "npm run verify:regression && npm run verify:env && npm run test:core && npm run test:perf && npm run live:smoke && npx tsc --noEmit && npx next lint && npx next build",
    "verify:governance:docs": "node scripts/verify-repo-governance.mjs",
    "qa:governance": "node scripts/governance-qa-gate.mjs",
    "verify:governance": "npm run verify:governance:docs && npm run qa:governance",
    "audit:no-clerk": "node scripts/audit-no-clerk.mjs",
    "migration:analyze": "tsx scripts/migration-cli.ts analyze",
    "migration:dry-run": "tsx scripts/migration-cli.ts dry-run",
    "migration:execute": "tsx scripts/migration-cli.ts execute",
    "migration:verify": "tsx scripts/migration-cli.ts verify",
    "migration:purge-dry-run": "tsx scripts/migration-cli.ts purge-dry-run",
    "migration:purge-execute": "tsx scripts/migration-cli.ts purge-execute",
    "migration:planJoshua": "tsx scripts/plan-joshua-account-migration.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-virtual": "^3.13.24",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "argon2": "^0.44.0",
    "clsx": "^2.1.1",
    "convex": "^1.17.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.460.0",
    "next": "15.5.15",
    "papaparse": "^5.4.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^6.0.2",
    "stripe": "^17.7.0",
    "tailwind-merge": "^2.5.4",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/papaparse": "^5.3.15",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "eslint": "^9.15.0",
    "eslint-config-next": "15.5.15",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "uuid": "^11.1.0"
  }
}
