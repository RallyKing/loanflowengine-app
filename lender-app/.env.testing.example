# Copy to `.env.testing` (gitignored). Never commit real secrets.
#
# Convex: set TESTING_SEED_SECRET in the Convex dashboard to match this file.

TESTING_SEED_SECRET=replace-with-long-random-secret

# Multi-persona workspace login (Next.js must see these at runtime too)
APP_AUTH_E2E_USERS_ENABLED=true

# Playwright defaults to E2E sandbox (see tests/helpers/workspace-auth.ts).
# PLAYWRIGHT_E2E_PERSONA=super_admin
# PLAYWRIGHT_USE_PRIMARY_AUTH=1

# Printed by `npm run seed:test-data`
E2E_ORG_PRIMARY_ID=
E2E_ORG_SECONDARY_ID=

# Passwords for catalog users (see docs/testing/testing-credentials.md)
E2E_PASS_SUPER_ADMIN=
E2E_PASS_ORG_OWNER=
E2E_PASS_TEAM_MEMBER=
E2E_PASS_LOAN_OFFICER=
E2E_PASS_PROCESSOR=
E2E_PASS_REFERRAL_PARTNER=
E2E_PASS_LENDER_REP=
E2E_PASS_READ_ONLY=
E2E_PASS_DEMO_SANDBOX=
# Portal identity seed — 6–128 characters (product policy)
E2E_PASS_CLIENT_PORTAL=

# Optional: decrypt Playwright *.enc auth blobs (64 hex chars = 32 bytes)
# TEST_SESSION_ENCRYPTION_KEY=

# Optional: persisted Playwright storage state path
# PW_STORAGE_STATE=playwright/.auth/org_owner.json

# Optional: performance spec budget (ms)
# PERF_BUDGET_MS=8000
