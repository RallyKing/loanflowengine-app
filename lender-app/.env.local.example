# Copy to `.env.local`. After `npx convex dev` (once), Convex can write this URL for you.
#
# Local:  http://127.0.0.1:<port> (often 3210)
# Hosted: https://<name>.convex.cloud
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# Optional (hosted only): same slug as .convex.cloud — used for httpRouter / webhooks (e.g. https://basic-anaconda-984.convex.site)
# NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Shared secret (≥24 chars): set the SAME value on your Convex deployment (dashboard → Settings → Environment Variables).
# Used to HMAC-gate server-to-Convex auth bridges (login lookup, signup, password reset, session revoke).
AUTH_BRIDGE_SECRET=replace-with-a-long-random-string-at-least-24-chars

# Optional: local dev only — forgot-password API returns devResetToken in JSON when "1".
# AUTH_DEBUG_RESET=1

# --- Quick path to live data + UI ---
# 1. From `lender-app`: `npm install`
# 2. `npm run dev` — starts Next.js and `convex dev` (pushes `convex/` and keeps DB in sync).
# 3. Ensure this URL matches the deployment `convex dev` prints (local or cloud).
# 4. Optional: `npm run seed` — loads `../Comprehensive_Lender_List.csv` (repo root) into lenders.
# 5. Sanity: `npm run live:check` — env URL, lenders.stats, tasks attachment counts, discovery status.

# --- Single-user login (HMAC cookie session) ---
# The login route refuses sign-in until both username and password are non-empty,
# so an unconfigured deployment is safe-by-default. The session cookie is HMAC-signed
# with APP_AUTH_SESSION_SECRET — must be ≥32 chars, ideally a 64-char hex string.
APP_AUTH_USERNAME=your-username
APP_AUTH_PASSWORD=your-password
APP_AUTH_SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Profile embedded in the session cookie (and mirrored on Convex as APP_AUTH_* for viewer fallbacks)
APP_AUTH_USER_KEY=your-stable-user-id
APP_AUTH_USER_EMAIL=you@example.com
APP_AUTH_USER_FULL_NAME=Your Name
# Convex `organizations` document id for this workspace (not a third-party org id)
APP_AUTH_ORGANIZATION_ID=your-organization-doc-id
APP_AUTH_ORGANIZATION_NAME=Your workspace name
# Optional: defaults to admin — set to "member" for workspace:member
# APP_AUTH_WORKSPACE_ROLE=admin

# Custom domains (middleware): primary hostname for this Next.js deployment (no tenant mapping).
# Production example: app.yourcompany.com or your-app.vercel.app
# Leave unset locally so tenant hostnames are not compared against an empty canonical host.
# NEXT_PUBLIC_APP_CANONICAL_HOST=dlcfunds.vercel.app

# Optional — Convex actions: auto-add hostname to a Vercel project (SSL follows in dashboard).
# Set on Convex dashboard: VERCEL_API_TOKEN, VERCEL_PROJECT_ID

# AI / discovery enrich (optional): set OPENAI_API_KEY, PERPLEXITY_API_KEY, SERPAPI_KEY
# in the Convex dashboard (Settings → Environment Variables) for server functions — not required for browse/pipeline/tasks.

# Optional — one-shot: canonical primary admin + password + merge alias auth users + lowercase auth fields
# (needs DATA_MIGRATION_ADMIN_SECRET on Convex and locally). See scripts/ensure-primary-platform-admin.ts
# npm run admin:ensure-primary
# NEW_PASSWORD='simple@123' npm run admin:ensure-primary
#
# Optional — operator migrations / password reset (must match Convex dashboard → same variable name).
# DATA_MIGRATION_ADMIN_SECRET=long-random-string
# ORG_INTEGRITY_ADMIN_SECRET=long-random-string
# Optional — point at a gitignored file (first line only = secret); see .gitignore `.migration-admin.secret`
# DATA_MIGRATION_ADMIN_SECRET_FILE=.migration-admin.secret

# Optional — automated snapshots (see `convex/dataBackup.ts`, `convex/backupRegistry.ts`).
# Set on Convex: DATA_BACKUP_ADMIN_SECRET (for list / manual backup / restore plan).
# Optional: DATA_BACKUP_ENABLED=false disables the daily cron (manual backup still works).

# Optional — client portal field encryption (AES-256-GCM for request description / client notes at rest).
# Generate 32 random bytes, base64-encode, set as CLIENT_PORTAL_FIELD_ENCRYPTION_KEY in Convex dashboard.
# When unset, those fields remain stored as plaintext (backward compatible).
